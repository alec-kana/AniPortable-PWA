# AniList client_id, from https://anilist.co/settings/developer
#
# Each AniList app registers exactly ONE Redirect URL, and login is a
# full-page redirect that lands back on that exact URL (see src/lib/auth.ts)
# — so dev and prod need separate AniList apps, each with its own client_id:
#
#   .env.development   npm run dev       redirect URL: http://localhost:5173/
#   .env.production     npm run build     redirect URL: <your deployed origin>/
#
VITE_ANILIST_CLIENT_ID=
